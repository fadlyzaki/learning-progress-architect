# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Storage provider. Use "sqlite" for local development and "alloydb" for Postgres/AlloyDB.
DB_PROVIDER="sqlite"

# DATABASE_FILE: local SQLite path used when DB_PROVIDER=sqlite
DATABASE_FILE="app.db"

# DATABASE_URL: Postgres/AlloyDB connection string used when DB_PROVIDER=alloydb
DATABASE_URL=""

# Agent provider. Use "legacy" to keep Gemini in-process, or "adk" to route through the Python ADK service.
AGENT_PROVIDER="legacy"

# ADK_SERVICE_URL: internal base URL for the Python ADK service when AGENT_PROVIDER=adk
ADK_SERVICE_URL="http://127.0.0.1:8081"

# Internal service-to-service settings
APP_BASE_URL="http://127.0.0.1:3000"
INTERNAL_SERVICE_TOKEN="replace-with-a-shared-secret"

# MCP server settings for the internal tool layer
MCP_PORT="3101"
MCP_BASE_URL="http://127.0.0.1:3101"

# Optional Google Cloud / AlloyDB metadata for deployment automation and service wiring
VERTEX_PROJECT_ID=""
ALLOYDB_INSTANCE=""
ALLOYDB_DATABASE=""
ALLOYDB_USER=""

LOG_LEVEL="debug"
NODE_ENV="development"
LOG_PRETTY="true"